NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway
# ���� ��� integration-������; ��� �� ��� ������������
TEST_DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway_test
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://redis:6379
# минимум 32 символа; сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# статичный ключ admin-API (заголовок X-Admin-Api-Key), минимум 32 символа; генерация так же, как для WEBHOOK_SECRET
ADMIN_API_KEY=
WORKER_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=8
