NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway
# база для integration-тестов; без неё они пропускаются
TEST_DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway_test
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://redis:6379
# Redis РґР»СЏ integration-С‚РµСЃС‚РѕРІ РѕС‡РµСЂРµРґРё; Р±РµР· РЅРµРіРѕ РѕРЅРё РїСЂРѕРїСѓСЃРєР°СЋС‚СЃСЏ
TEST_REDIS_URL=
# РјРёРЅРёРјСѓРј 32 СЃРёРјРІРѕР»Р°; СЃРіРµРЅРµСЂРёСЂРѕРІР°С‚СЊ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# СЃС‚Р°С‚РёС‡РЅС‹Р№ РєР»СЋС‡ admin-API (Р·Р°РіРѕР»РѕРІРѕРє X-Admin-Api-Key), РјРёРЅРёРјСѓРј 32 СЃРёРјРІРѕР»Р°; РіРµРЅРµСЂР°С†РёСЏ С‚Р°Рє Р¶Рµ, РєР°Рє РґР»СЏ WEBHOOK_SECRET
ADMIN_API_KEY=
WORKER_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=8
# максимальный размер тела входящего вебхука, байт (по умолчанию 1 МБ)
BODY_LIMIT_BYTES=1048576
