NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway
# ���� ��� integration-������; ��� �� ��� ������������
TEST_DATABASE_URL=postgres://gateway:gateway@postgres:5432/gateway_test
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://redis:6379
# Redis для integration-тестов очереди; без него они пропускаются
TEST_REDIS_URL=
# минимум 32 символа; сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# статичный ключ admin-API (заголовок X-Admin-Api-Key), минимум 32 символа; генерация так же, как для WEBHOOK_SECRET
ADMIN_API_KEY=
WORKER_CONCURRENCY=5
MAX_RETRY_ATTEMPTS=8
# backoff между повторами: base × 2^(n-1) с full jitter, не больше потолка, мс
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=3600000
# жёсткий таймаут одного HTTP-запроса доставки, мс
DELIVERY_TIMEOUT_MS=10000
# ������������ ������ ���� ��������� �������, ���� (�� ��������� 1 ��)
BODY_LIMIT_BYTES=1048576
# recovery sweeper: период запуска, мс
SWEEPER_INTERVAL_MS=30000
# pending без задачи в Redis считается потерянным через, мс
SWEEPER_STALE_AFTER_MS=30000
# processing считается застрявшим через, мс (больше DELIVERY_TIMEOUT_MS)
SWEEPER_PROCESSING_TIMEOUT_MS=60000
# максимум событий за один проход
SWEEPER_BATCH_SIZE=100
